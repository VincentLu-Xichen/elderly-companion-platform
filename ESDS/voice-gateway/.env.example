# Gateway and device protocol
ESDS_HOST=127.0.0.1
ESDS_PORT=8765
ESDS_DEVICE_TOKEN=
# local = modular ASR + emotion2vec + Ollama + TTS
# qwen_realtime = cloud ASR/LLM/TTS, suitable for a lightweight Raspberry Pi gateway
# mock = offline protocol development
ESDS_RUNTIME_PROVIDER=local

# ASR: sensevoice (local) or qwen (Alibaba Model Studio)
ESDS_ASR_PROVIDER=sensevoice
ESDS_SENSEVOICE_MODEL_DIR=/absolute/path/to/sherpa-onnx-sense-voice-int8
ESDS_SENSEVOICE_THREADS=2
ESDS_QWEN_ASR_MODEL=qwen3-asr-flash-realtime
ESDS_QWEN_ASR_REGION=beijing
ESDS_QWEN_ASR_WORKSPACE_ID=
ESDS_QWEN_ASR_LANGUAGE=zh
ESDS_QWEN_ASR_CONTEXT=ESDS 语音共情 emotion2vec Cherry
ESDS_QWEN_ASR_TIMEOUT_SECONDS=8

# Alibaba Qwen Omni Realtime profile
ESDS_QWEN_REALTIME_MODEL=qwen3.5-omni-flash-realtime
ESDS_QWEN_REALTIME_VOICE=Tina
ESDS_QWEN_REALTIME_REGION=beijing
ESDS_QWEN_REALTIME_WORKSPACE_ID=

# Speech emotion: emotion2vec or heuristic
ESDS_EMOTION_BACKEND=emotion2vec
ESDS_EMOTION2VEC_MODEL_DIR=/absolute/path/to/emotion2vec_plus_base
ESDS_EMOTION2VEC_THREADS=4
ESDS_EMOTION_TIMEOUT_MS=240

# Local dialogue model
ESDS_OLLAMA_URL=http://127.0.0.1:11434
ESDS_OLLAMA_MODEL=qwen3:4b-instruct
ESDS_CHAT_PROVIDER=ollama
ESDS_CBT_LESSON_ID=lesson-1
ESDS_AGENT_BRIDGE_URL=http://127.0.0.1:8000
ESDS_AGENT_BRIDGE_TOKEN=
ESDS_AGENT_BRIDGE_DEVICE_ID=
ESDS_AGENT_BRIDGE_TIMEOUT_SECONDS=65
ESDS_HISTORY_TURNS=8

# TTS: qwen (recommended) or edge
ESDS_TTS_PROVIDER=qwen
ESDS_QWEN_TTS_MODEL=qwen3-tts-instruct-flash-realtime
ESDS_QWEN_TTS_VOICE=Cherry
ESDS_QWEN_TTS_REGION=beijing
ESDS_QWEN_TTS_WORKSPACE_ID=
ESDS_QWEN_TTS_OPTIMIZE_INSTRUCTIONS=false
ESDS_EDGE_TTS_VOICE=zh-CN-XiaoyiNeural
ESDS_FFMPEG_PATH=ffmpeg

# Shared Alibaba Model Studio credential. Keep it on the gateway only.
DASHSCOPE_API_KEY=

# Audio and VAD
ESDS_SAMPLE_RATE=24000
ESDS_FRAME_MS=20
ESDS_MAX_UTTERANCE_SECONDS=20
ESDS_VAD_START_DBFS=-43
ESDS_VAD_STOP_DBFS=-49
ESDS_VAD_START_SNR_DB=14
ESDS_VAD_STOP_SNR_DB=6
ESDS_VAD_START_FRAMES=4
ESDS_VAD_STOP_FRAMES=18
ESDS_VAD_CALIBRATION_MS=500
ESDS_VAD_NOISE_WINDOW_MS=3000
ESDS_SPEECH_ENHANCE=true
ESDS_SPEECH_ENHANCE_BACKEND=spectral
ESDS_PLAYBACK_ECHO_GUARD_MS=450
ESDS_ASR_REPLY_MIN_CHARS=2
ESDS_MAX_AUDIO_MESSAGE_BYTES=48000
ESDS_MAX_WS_MESSAGE_BYTES=64000
ESDS_MAX_QUEUE_FRAMES=100
ESDS_MAX_CONNECTIONS=32
ESDS_LOG_LEVEL=INFO

# Raspberry Pi native ALSA client (ChuangLeBo USB voice module)
ESDS_PI_CAPTURE_DEVICE=plughw:CARD=Device,DEV=0
ESDS_PI_PLAYBACK_DEVICE=plughw:CARD=Device,DEV=0
ESDS_PI_MIXER_CARD=Device
ESDS_PI_CAPTURE_VOLUME_CONTROL=Mic Capture Volume
ESDS_PI_CAPTURE_SWITCH_CONTROL=Mic Capture Switch
ESDS_PI_CAPTURE_SWITCH_VALUE=on
ESDS_PI_PLAYBACK_VOLUME_CONTROL=Speaker Playback Volume
ESDS_PI_PLAYBACK_SWITCH_CONTROL=Speaker Playback Switch
ESDS_PI_CAPTURE_GAIN=128
ESDS_PI_AUTO_GAIN_MAX_DB=18
ESDS_PI_AUTO_GAIN_TARGET_DBFS=-20
ESDS_PI_PLAYBACK_VOLUME=800
