APP_ENV=production
APP_SECRET=replace-with-a-long-random-secret
DATA_ENCRYPTION_KEY=replace-with-urlsafe-base64-encoded-32-byte-key
DATABASE_URL=sqlite:///./roleplay_chat.db
DATABASE_POOL_MODE=application
INVITE_CODES=student-001:replace-code-1,student-002:replace-code-2
ADMIN_PASSWORD=replace-admin-password
CONSENT_VERSION=2026-07-v1
# 每次修改对应 Agent 的 Prompt 或逻辑时递增，用于冻结会话实验批次。
CBT_COURSE_AGENT_VERSION=course-v1
DAILY_CHAT_AGENT_VERSION=daily-chat-v1
COOKIE_SECURE=true
SESSION_HOURS=12
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_PER_MINUTE=30

# Raspberry Pi Daily Chat voice bridge. Keep disabled for ordinary web deploys.
VOICE_BRIDGE_ENABLED=false
VOICE_BRIDGE_TOKEN=replace-with-a-long-random-device-token
VOICE_DEVICE_ID=esds-pi-replace-me
VOICE_PARTICIPANT_LABEL=esds-voice-user
# Set true only after the participant has acknowledged the current consent notice.
VOICE_CONSENT_ACKNOWLEDGED=false

# Daily Chat model provider: azure (original default) or dashscope.
DAILY_CHAT_PROVIDER=azure
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# CBT course model provider: dashscope (default) or azure.
CBT_COURSE_PROVIDER=dashscope
CBT_COURSE_MODEL=qwen-plus

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-key
AZURE_OPENAI_DEPLOYMENT=replace-deployment
# 可选：课程使用独立部署；留空时复用 AZURE_OPENAI_DEPLOYMENT。
AZURE_OPENAI_COURSE_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
